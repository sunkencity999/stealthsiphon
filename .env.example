# Copy to .env and adjust. Every value shown is the default.

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1                 # bind address; use 0.0.0.0 only together with an API key
PORT=4200
STEALTHSIPHON_API_KEY=         # if set, required on /api, /mcp and legacy endpoints (Bearer or X-API-Key)
CORS_ORIGINS=                  # comma-separated origins allowed to call the API from a browser
DATA_DIR=data                  # SQLite DB, scheduled-task results

# --- Network safety -------------------------------------------------------
ALLOW_PRIVATE_NETWORKS=false   # allow fetching localhost / LAN / metadata IPs (dangerous with agents)
ALLOW_PRIVATE_WEBHOOKS=false   # allow task webhooks to target private addresses (e.g. a local n8n)
MAX_RESPONSE_BYTES=15728640
REQUEST_TIMEOUT_MS=30000

# --- Politeness -------------------------------------------------------------
RESPECT_ROBOTS=true            # default for every request; override per request with respectRobots=false
PER_HOST_CONCURRENCY=2
PER_HOST_MIN_INTERVAL_MS=250
# USER_AGENT=Mozilla/5.0 ...   # default is a current desktop Chrome UA
ROBOTS_USER_AGENT=StealthSiphon

# --- Cache ------------------------------------------------------------------
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=200

# --- Browser ----------------------------------------------------------------
CHROME_PATH=                   # auto-detects Chrome/Chromium/Edge/Brave if empty
BROWSER_HEADLESS=true
MAX_BROWSER_SESSIONS=5
BROWSER_SESSION_IDLE_MS=600000
ALLOW_EVALUATE=true            # expose browser_evaluate (run JS in session pages)

# --- LLM extraction (extract tool with a JSON schema) -----------------------
LLM_PROVIDER=auto              # auto | lmstudio | ollama | openai
                               # auto = whichever local server is up, preferring one with a model loaded
LLM_TIMEOUT_MS=180000
LMSTUDIO_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=                # empty = the model currently loaded in LM Studio
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=                  # empty = first installed (non-embedding) model
OPENAI_COMPAT_URL=             # any OpenAI-compatible server: vLLM, llama.cpp, LocalAI, a hosted API
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# --- MCP stdio --------------------------------------------------------------
MCP_RUN_SCHEDULER=true         # stdio MCP process may run scheduled tasks if no server is running

# --- Optional DB export targets for the web UI ------------------------------
MONGODB_URL=
MYSQL_URL=
